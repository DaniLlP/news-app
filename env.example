# News API Configuration
# Get free API key from https://newsapi.org/
VITE_NEWS_API_KEY=your_newsapi_key_here

# Finance API Configuration
# Alpha Vantage: https://www.alphavantage.co/
VITE_ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Polygon.io for stock market data
VITE_POLYGON_KEY=your_polygon_key_here

# Optional: RSS Feed Aggregator
VITE_RSS_ENDPOINT=https://api.rss2json.com/v1/api.json

# App Configuration
VITE_APP_NAME=NEWS HUB
VITE_APP_DESCRIPTION=Premium news aggregation for Spain, Catalonia, Barcelona and international news
